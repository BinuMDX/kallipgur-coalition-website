# ==================================================
# Kallipgur Coalition Aboriginal Corporation
# Environment Variables
# ==================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ==================================================

# PostgreSQL Docker Service
POSTGRES_USER=kallipgur
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=kallipgur_db

# Prisma Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Use "localhost" when running the app outside Docker, or "postgres" (the
# docker-compose service name) when the app itself runs inside docker-compose.
DATABASE_URL=postgresql://kallipgur:your_secure_password_here@localhost:5432/kallipgur_db?schema=public

# Document Uploads
UPLOADS_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Email Configuration
# Providers: microsoft-graph, mailpit, console
EMAIL_PROVIDER=mailpit

# Microsoft Graph API (Production)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SENDER_EMAIL=

# SMTP / Mailpit (Development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Notification Recipient
MEMBERSHIP_NOTIFICATION_EMAIL=
APP_URL=

# ==================================================
# Authentication & Admin
# ==================================================

# NextAuth Secret for JWT Encryption
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Seed Admin User Configuration
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
