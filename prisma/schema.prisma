// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DocumentType {
  IDENTITY
  SUPPORTING_DOCUMENT
  PROFILE_PHOTO
}

// ──────────────────────────────────────────────
// Models
// ──────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}


model MembershipApplication {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Personal Information ──────────────────
  firstName              String
  lastName               String
  dateOfBirth            DateTime
  gender                 String
  email                  String
  phone                  String
  preferredContactMethod String?

  // ── Address ───────────────────────────────
  streetAddress String
  suburb        String
  state         String
  postcode      String
  country       String

  // ── Membership ────────────────────────────
  membershipType                String
  traditionalCountry            String?
  aboriginalOrTorresStraitIslander String

  // ── About ─────────────────────────────────
  occupation          String?
  reasonForJoining    String?
  skillsAndExperience String?
  areasOfInterest     String[]

  // ── Emergency Contact ─────────────────────
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?

  // ── Documents ─────────────────────────────
  documents            MembershipDocument[]

  // ── Declaration ───────────────────────────
  informationDeclarationAccepted Boolean
  privacyPolicyAccepted          Boolean
  membershipTermsAccepted        Boolean

  // ── Application Management ────────────────
  status             ApplicationStatus @default(PENDING)
  applicantEmailSent Boolean           @default(false)
  adminEmailSent     Boolean           @default(false)

  notes              MembershipNote[]
  auditLogs          MembershipAuditLog[]

  // ── Indexes ───────────────────────────────
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model MembershipDocument {
  id               String       @id @default(cuid())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  applicationId    String
  application      MembershipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  documentType     DocumentType
  originalFileName String
  storedFileName   String       @unique
  mimeType         String
  fileSize         Int          // bytes

  @@index([applicationId])
  @@index([documentType])
}

model MembershipNote {
  id            String                @id @default(cuid())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  applicationId String
  application   MembershipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  adminId       String
  adminName     String
  note          String

  @@index([applicationId])
}

model MembershipAuditLog {
  id            String                @id @default(cuid())
  createdAt     DateTime              @default(now())

  applicationId String
  application   MembershipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  adminId       String
  adminName     String
  action        String                // STATUS_CHANGE, NOTE_ADDED, DOCUMENT_UPLOADED, EMAIL_SENT, APPLICATION_SUBMITTED
  previousStatus String?
  newStatus      String?
  reviewNote     String?

  @@index([applicationId])
  @@index([createdAt])
}
